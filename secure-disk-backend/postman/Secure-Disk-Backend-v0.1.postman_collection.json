{
  "info": {
    "name": "Secure Disk Backend v0.1",
    "description": "Local smoke-test flow: CSRF -> register -> verify email -> login -> refresh -> logout. Cookies are managed by the Postman cookie jar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "testEmail",
      "value": "postman-test@example.com"
    },
    {
      "key": "testPassword",
      "value": "ChangeThis-Postman-Password-2026!"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "syncRoomId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Get CSRF token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('csrfToken', body.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"display_name\": \"Postman Test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body.dev_verification_token) pm.collectionVariables.set('verificationToken', body.dev_verification_token);",
              "pm.test('Development verification token is present', function () { pm.expect(body.dev_verification_token).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Verify email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/verify-email"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Email verified', function () { pm.expect(pm.response.json().email_verified).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('syncRoomId', body.sync_room_id);",
              "pm.collectionVariables.set('csrfToken', body.csrf_token);",
              "pm.test('sync_room_id returned', function () { pm.expect(body.sync_room_id).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Current session (me)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('syncRoomId', body.sync_room_id);",
              "pm.test('sync_room_id restored', function () { pm.expect(body.sync_room_id).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Refresh session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/auth/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('csrfToken', body.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Logged out', function () { pm.expect(pm.response.json().logged_out).to.eql(true); });"
            ]
          }
        }
      ]
    }
  ]
}
